# AgriSmart AI Environment Variables
PROJECT_NAME="AgriSmart AI — Intelligent Smart Agriculture Platform"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (SQLite default for local run or PostgreSQL)
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/agrismart_db
DATABASE_URL=sqlite:///./agrismart.db

# JWT Authentication Security
# Generate random key: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Weather Integration (OpenWeatherMap API Key)
# If empty, AgriSmart uses its intelligent agricultural weather simulation engine
WEATHER_API_KEY=

# AI Agriculture Chatbot (Optional OpenAI / Anthropic / Gemini Key)
# If empty, AgriSmart uses its built-in agronomic expert knowledge engine
LLM_API_KEY=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Uploads directory
UPLOAD_DIR="./uploads"
