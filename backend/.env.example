# AgriSmart AI Backend Environment Variables
PROJECT_NAME="AgriSmart AI — Intelligent Smart Agriculture Platform"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (SQLite default or PostgreSQL)
DATABASE_URL=sqlite:///./agrismart.db

# JWT Authentication Security
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Weather Integration (OpenWeatherMap API Key)
WEATHER_API_KEY=

# AI Agriculture Chatbot (Optional OpenAI / Anthropic / Gemini Key)
LLM_API_KEY=

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Uploads directory
UPLOAD_DIR="./uploads"
